{
  "expo": {
    "name": "Entrega Já Entregador",
    "slug": "entrega-ja-entregador",
    "scheme": "entregaja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF7622"
    },
    "ios": {
      "bundleIdentifier": "dev.entregaja.entregador",
      "supportsTablet": false,
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "dev.entregaja.entregador",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "O Entrega Já usa sua localização enquanto você está online, inclusive com o app em segundo plano, para oferecer entregas perto de você e mostrar à cliente onde está o pedido.",
          "locationWhenInUsePermission": "O Entrega Já usa sua localização para oferecer entregas perto de você.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF7622",
          "defaultChannel": "offers",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}